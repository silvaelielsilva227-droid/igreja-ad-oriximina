{
  "name": "ad-oriximina-gestao",
  "productName": "AD Oriximina Gestao",
  "version": "1.0.0",
  "description": "Sistema de gestão da Igreja Assembleia de Deus – Extensão de Oriximiná",
  "author": "AD Extensao de Oriximina",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.org.adoriximina.gestao",
    "productName": "AD Oriximina Gestao",
    "directories": { "output": "dist" },
    "files": ["main.js", "offline.html", "icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AD Oriximiná",
      "artifactName": "AD-Oriximina-Instalador.${ext}"
    },
    "portable": { "artifactName": "AD-Oriximina-Portatil.${ext}" }
  }
}
